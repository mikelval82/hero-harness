# Copy this file to .env or .env.local. Never commit real credentials.
# Existing process environment variables take precedence over file values.

# Choose a provider. HARNESS_MODEL forces one model for every phase.
# HARNESS_PROVIDER=anthropic
# HARNESS_MODEL=
# Optional policy tiers. DeepSeek defaults to V4 Flash for cheap/default and V4 Pro for deep.
# HARNESS_MODEL_CHEAP=
# HARNESS_MODEL_DEFAULT=
# HARNESS_MODEL_DEEP=

# Optional Anthropic provider. Install with: pip install -e ".[anthropic]"
# ANTHROPIC_API_KEY=

# Optional DeepSeek provider. Install with: pip install -e ".[deepseek]"
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional Telegram control. Both values are required together.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional explicit Git identity for mission commits.
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
