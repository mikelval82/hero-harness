# Anthropic API key (required)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Telegram notifications and single-mission control.
# Configure both values or neither. The chat must be a private chat with the bot.
# A bot token can belong to only one active mission at a time.
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: git author for automated commits
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
